{
  "name": "homelab-tui",
  "version": "2.3.0",
  "license": "MIT",
  "type": "module",
  "bin": {
    "homelab-tui": "./src/cli.tsx"
  },
  "scripts": {
    "dev": "bun run src/cli.tsx",
    "start": "bun run src/cli.tsx",
    "build:linux-x64": "bun build --compile --target=bun-linux-x64 src/cli.tsx --outfile dist/homelab-tui-linux-x64",
    "build:linux-arm64": "bun build --compile --target=bun-linux-arm64 src/cli.tsx --outfile dist/homelab-tui-linux-arm64",
    "build:darwin-x64": "bun build --compile --target=bun-darwin-x64 src/cli.tsx --outfile dist/homelab-tui-darwin-x64",
    "build:darwin-arm64": "bun build --compile --target=bun-darwin-arm64 src/cli.tsx --outfile dist/homelab-tui-darwin-arm64",
    "build:windows-x64": "bun build --compile --target=bun-windows-x64 src/cli.tsx --outfile dist/homelab-tui-windows-x64.exe",
    "build:native-deps": "bun install --os=\"*\" --cpu=\"*\"",
    "build": "bun run build:native-deps && bun run build:linux-x64 && bun run build:linux-arm64 && bun run build:darwin-x64 && bun run build:darwin-arm64 && bun run build:windows-x64",
    "release:patch": "npm version patch && git push && git push --tags",
    "release:minor": "npm version minor && git push && git push --tags",
    "release:major": "npm version major && git push && git push --tags",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "overrides": {
    "ws": "^8.21.3"
  },
  "dependencies": {
    "@opentui/core": "^0.5.11",
    "@opentui/react": "^0.5.11",
    "node-ssh": "^13.2.0",
    "react": "^19.2.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^20.0.0",
    "@types/react": "^19.2.0",
    "typescript": "^5.4.5",
    "vitepress": "^2.0.0-alpha.20"
  }
}
